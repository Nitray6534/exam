# Salin menjadi .env lalu isi.
PORT=5000
NODE_ENV=development

# Connection string MongoDB Atlas (Database > Connect > Drivers).
# Kosongkan saat development untuk memakai MongoDB in-memory otomatis.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skilllearn?retryWrites=true&w=majority

# Rahasia penandatangan JWT, isi string acak panjang (wajib di production).
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

# Origin yang boleh mengakses API (pisahkan dengan koma). * = semua.
CORS_ORIGIN=*

# Isi materi awal otomatis jika koleksi materials masih kosong.
AUTO_SEED=true
# Buat akun demo (demo@skilllearn.app / Demo12345) saat seed.
SEED_DEMO_USER=true
